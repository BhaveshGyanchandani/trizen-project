# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# MongoDB connection string. Photo files are stored in this same database
# via GridFS (see lib/storage.js) — no separate object-storage account is
# needed, in local dev or in production.
MONGODB_URL=mongodb://localhost:27017/trizen

# Secret used to sign auth JWTs. Set a long random value in production —
# the fallback in lib/authHelper.js is dev-only and not safe to rely on.
JWT_SECRET=
