# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# MongoDB connection string. This database contains users, events, photo
# metadata, and gallery state; Cloudinary stores image bytes separately.
MONGODB_URL=mongodb://localhost:27017/trizen

# Secret used to sign auth JWTs. Set a long random value in production —
# the fallback in lib/authHelper.js is dev-only and not safe to rely on.
JWT_SECRET=

# Server-only Cloudinary credentials. Never prefix these with NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Alternatively, provide all three values in a single server-only URL:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
