# Copy this file to .env.local and fill in real values. Never commit
# .env.local — it's already excluded in .gitignore.

# MongoDB connection string (Atlas or self-hosted).
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# Secret used to sign/verify JWT auth cookies (both the staff session cookie
# and the short-lived gallery-PIN-access cookie). Use a long random string —
# e.g. `openssl rand -base64 48`. There is no default: the app throws on
# startup if this is missing, on purpose, so a misconfigured deployment
# fails loudly instead of silently using a guessable secret.
JWT_SECRET=

# Cloudinary — used for all photo/avatar/cover-photo storage. Only metadata
# and Cloudinary identifiers are ever written to MongoDB; image bytes never
# touch the database. Either set the three discrete values below, or set
# CLOUDINARY_URL alone (cloudinary://<api_key>:<api_secret>@<cloud_name>) —
# the app accepts either form.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Optional: only needed if the frontend and API are ever split into
# separate deployments. Leave unset for the default same-origin setup.
# NEXT_PUBLIC_API_URL=
